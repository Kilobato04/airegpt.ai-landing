# AIreGPT · Environment variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env for local development (never commit .env)
# Set these in: Netlify UI → Site settings → Environment variables
# ─────────────────────────────────────────────────────────────

# AWS API Gateway endpoint for air quality data
# (set the real URL in Netlify UI; never put it in code or index.html)
AIR_QUALITY_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/api/air-quality/current?type=reference
